{
  "name": "holdthat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resume interrupted tasks from confirmed checkpoints",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx src/server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx scripts/test-browser.ts",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
