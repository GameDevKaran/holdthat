# Local default: deterministic text controls; no model calls or invented live evidence.
HOST=127.0.0.1
PORT=3210
HOLDTHAT_DATABASE_PATH=.local/holdthat.sqlite
# sqlite for a local persistent volume; gcs for Cloud Run (no silent fallback).
HOLDTHAT_STORE=sqlite
HOLDTHAT_GCS_BUCKET=tough-melody-508008-p8-holdthat-sessions
# Set to the exact public HTTPS origin for deployment.
HOLDTHAT_ORIGIN=
NODE_ENV=development
# none | bedrock. Only enable bedrock after account/budget authorization.
HOLDTHAT_MODEL_PROVIDER=none
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
# Explicit bounded runtime controls; these are limits, not spending approvals.
HOLDTHAT_MODEL_CALLS_PER_SESSION=30
HOLDTHAT_MODEL_CALLS_PER_DAY=300

# Approved hosting project only. These are deployment references, not created resources.
GCP_PROJECT_ID=tough-melody-508008-p8
GCP_REGION=us-central1
GCP_SERVICE=holdthat
# Attach a dedicated runtime identity at deployment; do not use an existing app identity.
GCP_RUNTIME_SERVICE_ACCOUNT=
# New cloud charges require approval; this placeholder does not grant it.
CLOUD_SPENDING_APPROVAL_REFERENCE=
